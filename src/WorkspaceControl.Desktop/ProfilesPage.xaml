<Page
    x:Class="WorkspaceControl.Desktop.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="ProfilesPage_Title" FontSize="32" FontWeight="SemiBold" />
                <TextBlock
                    x:Uid="ProfilesPage_Subtitle"
                    Opacity="0.72"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="18"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="ProfilesPage_ChooseHeading" FontSize="20" FontWeight="SemiBold" />
                    <ListView
                        x:Name="ProfileList"
                        x:Uid="ProfilesPage_ProfileList"
                        ItemsSource="{Binding Profiles}"
                        SelectionMode="Single"
                        SelectionChanged="ProfileList_SelectionChanged"
                        MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4" Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" />
                                    <TextBlock Text="{Binding Id}" Opacity="0.55" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        x:Name="CreatePlanButton"
                        x:Uid="ProfilesPage_GeneratePlan"
                        Click="CreatePlanButton_Click"
                        HorizontalAlignment="Left"
                        IsEnabled="False" />
                </StackPanel>
            </Border>

            <Border
                Padding="18"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="ProfilesPage_ReviewHeading" FontSize="20" FontWeight="SemiBold" />

                    <TextBlock
                        x:Uid="ProfilesPage_Status"
                        Text="{Binding ProvisioningStatusDisplay}"
                        FontSize="17"
                        FontWeight="SemiBold" />

                    <TextBlock
                        x:Uid="ProfilesPage_Progress"
                        Text="{Binding ProvisioningProgressDisplay}"
                        Opacity="0.72" />

                    <TextBlock
                        x:Uid="ProfilesPage_CurrentComponent"
                        Text="{Binding CurrentComponentDisplay}"
                        TextWrapping="Wrap"
                        Opacity="0.72" />

                    <ListView
                        x:Uid="ProfilesPage_PlanList"
                        ItemsSource="{Binding ProvisioningPlan.Items}"
                        SelectionMode="None"
                        MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding ComponentName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.72" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock x:Uid="ProfilesPage_InstalledVersion" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding InstalledVersion}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock x:Uid="ProfilesPage_AvailableVersion" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding AvailableVersion}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock x:Uid="ProfilesPage_DesiredVersion" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding DesiredVersion}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock
                                                x:Uid="ProfilesPage_ActionCode"
                                                Text="{Binding ActionCode}"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Uid="ProfilesPage_StateCode"
                                                Text="{Binding StateCode}"
                                                Opacity="0.65" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <InfoBar
                        x:Uid="ProfilesPage_ErrorInfoBar"
                        IsOpen="{Binding HasProvisioningError}"
                        Message="{Binding ProvisioningError}"
                        Severity="Error"
                        IsClosable="False" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="ConfirmButton"
                            x:Uid="ProfilesPage_Confirm"
                            Click="ConfirmButton_Click"
                            IsEnabled="{Binding IsAwaitingConfirmation}" />
                        <Button
                            x:Name="ResumeButton"
                            x:Uid="ProfilesPage_Resume"
                            Click="ResumeButton_Click"
                            IsEnabled="{Binding CanResumeProvisioning}" />
                    </StackPanel>

                    <ProgressRing
                        x:Uid="ProfilesPage_ProgressRing"
                        IsActive="{Binding IsProvisioningActive}"
                        Width="28"
                        Height="28" />

                    <TextBlock x:Uid="ProfilesPage_StaleNote" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
