<Page
    x:Class="WorkspaceControl.Desktop.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Profiles" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Desired-state presets available on this machine." Opacity="0.72" />
        </StackPanel>

        <ListView Grid.Row="1" Margin="0,20,0,0" ItemsSource="{Binding Profiles}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16" Margin="0,0,0,10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" />
                            <TextBlock Text="{Binding Id}" Opacity="0.55" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
