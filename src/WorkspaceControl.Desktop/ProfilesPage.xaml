<Page
    x:Class="WorkspaceControl.Desktop.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="WorkspacePage_Title" FontSize="32" FontWeight="SemiBold" />
                <TextBlock
                    x:Uid="WorkspacePage_Subtitle"
                    Opacity="0.72"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="18"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="WorkspacePage_WorkspaceHeading" FontSize="20" FontWeight="SemiBold" />

                    <ComboBox
                        x:Name="WorkspaceList"
                        x:Uid="WorkspacePage_WorkspaceList"
                        ItemsSource="{Binding Profiles}"
                        SelectionChanged="WorkspaceList_SelectionChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Opacity="0.72" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="WorkspaceNameBox"
                            x:Uid="WorkspacePage_Name"
                            Text="{Binding WorkspaceName, Mode=TwoWay}"
                            Grid.Column="0" />
                        <TextBox
                            x:Name="WorkspaceDescriptionBox"
                            x:Uid="WorkspacePage_Description"
                            Text="{Binding WorkspaceDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Grid.Column="1"
                            TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Uid="WorkspacePage_New" Click="NewWorkspaceButton_Click" />
                        <Button
                            x:Uid="WorkspacePage_Save"
                            Click="SaveWorkspaceButton_Click"
                            IsEnabled="{Binding HasSelectedWorkspace}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="18"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="WorkspacePage_ApplicationsHeading" FontSize="20" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="ApplicationSearchBox"
                        x:Uid="WorkspacePage_ApplicationSearch"
                        TextChanged="ApplicationSearchBox_TextChanged" />

                    <ListView
                        x:Name="ApplicationList"
                        x:Uid="WorkspacePage_ApplicationList"
                        ItemsSource="{Binding VisibleApplicationOptions}"
                        SelectionMode="None"
                        MaxHeight="420">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    x:Uid="WorkspacePage_ApplicationCheckBox"
                                    Content="{Binding Name}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                                    <CheckBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ComponentId}" />
                                                <TextBlock Text="{Binding Source}" Opacity="0.72" />
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border
                Padding="18"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="WorkspacePage_DiffHeading" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock
                        x:Uid="WorkspacePage_DiffDescription"
                        TextWrapping="Wrap"
                        Opacity="0.72" />

                    <ListView
                        x:Name="DesiredStateDiffList"
                        x:Uid="WorkspacePage_DiffList"
                        ItemsSource="{Binding DesiredStateDiffItems}"
                        SelectionMode="None"
                        MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.72" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_DiffObserved" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding ObservedValue}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_DiffAvailable" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding AvailableValue}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_DiffDesired" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding DesiredValue}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock
                                                x:Uid="WorkspacePage_DiffAction"
                                                Text="{Binding ActionCode}"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Uid="WorkspacePage_DiffState"
                                                Text="{Binding StateCode}"
                                                Opacity="0.65" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        x:Name="ObserveDiffButton"
                        x:Uid="WorkspacePage_ObserveDiff"
                        Click="ObserveDiffButton_Click"
                        HorizontalAlignment="Left"
                        IsEnabled="False" />
                    <Button
                        x:Name="CreatePlanButton"
                        x:Uid="WorkspacePage_GeneratePlan"
                        Click="CreatePlanButton_Click"
                        HorizontalAlignment="Left"
                        IsEnabled="False" />
                </StackPanel>
            </Border>

            <Border
                Padding="18"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="WorkspacePage_ReviewHeading" FontSize="20" FontWeight="SemiBold" />

                    <TextBlock
                        x:Uid="WorkspacePage_Status"
                        Text="{Binding ProvisioningStatusDisplay}"
                        FontSize="17"
                        FontWeight="SemiBold" />

                    <TextBlock
                        x:Uid="WorkspacePage_Progress"
                        Text="{Binding ProvisioningProgressDisplay}"
                        Opacity="0.72" />

                    <TextBlock
                        x:Uid="WorkspacePage_CurrentComponent"
                        Text="{Binding CurrentComponentDisplay}"
                        TextWrapping="Wrap"
                        Opacity="0.72" />

                    <ListView
                        x:Uid="WorkspacePage_PlanList"
                        ItemsSource="{Binding ProvisioningPlan.Items}"
                        SelectionMode="None"
                        MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding ComponentName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.72" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_InstalledVersion" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding InstalledVersion}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_AvailableVersion" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding AvailableVersion}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_DesiredVersion" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding DesiredVersion}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock
                                                x:Uid="WorkspacePage_ActionCode"
                                                Text="{Binding ActionCode}"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Uid="WorkspacePage_StateCode"
                                                Text="{Binding StateCode}"
                                                Opacity="0.65" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <InfoBar
                        x:Uid="WorkspacePage_ErrorInfoBar"
                        IsOpen="{Binding HasProvisioningError}"
                        Message="{Binding ProvisioningError}"
                        Severity="Error"
                        IsClosable="False" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="ConfirmButton"
                            x:Uid="WorkspacePage_Confirm"
                            Click="ConfirmButton_Click"
                            IsEnabled="{Binding IsAwaitingConfirmation}" />
                        <Button
                            x:Name="ResumeButton"
                            x:Uid="WorkspacePage_Resume"
                            Click="ResumeButton_Click"
                            IsEnabled="{Binding CanResumeProvisioning}" />
                    </StackPanel>

                    <ProgressRing
                        x:Uid="WorkspacePage_ProgressRing"
                        IsActive="{Binding IsProvisioningActive}"
                        Width="28"
                        Height="28" />

                    <TextBlock x:Uid="WorkspacePage_StaleNote" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
