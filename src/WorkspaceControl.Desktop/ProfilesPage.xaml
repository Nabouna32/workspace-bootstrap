<Page
    x:Class="WorkspaceControl.Desktop.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="Profiles &amp; provisioning" FontSize="32" FontWeight="SemiBold" />
                <TextBlock
                    Text="Review a persisted plan before Workspace Control changes this PC."
                    Opacity="0.72"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="18"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="1. Choose a desired state" FontSize="20" FontWeight="SemiBold" />
                    <ListView
                        x:Name="ProfileList"
                        ItemsSource="{Binding Profiles}"
                        SelectionMode="Single"
                        SelectionChanged="ProfileList_SelectionChanged"
                        MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4" Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" />
                                    <TextBlock Text="{Binding Id}" Opacity="0.55" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        x:Name="CreatePlanButton"
                        Content="Generate plan"
                        Click="CreatePlanButton_Click"
                        HorizontalAlignment="Left"
                        IsEnabled="False" />
                </StackPanel>
            </Border>

            <Border
                Padding="18"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="2. Review the plan" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{Binding ProvisioningStatusDisplay}"
                        FontSize="17"
                        FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProvisioningProgressDisplay}" Opacity="0.72" />
                    <TextBlock
                        Text="{Binding CurrentComponentDisplay}"
                        TextWrapping="Wrap"
                        Opacity="0.72" />

                    <ListView
                        ItemsSource="{Binding ProvisioningPlan.Items}"
                        SelectionMode="None"
                        MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding ComponentName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{Binding InstalledVersion}" Opacity="0.55" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ActionCode}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StateCode}" Opacity="0.65" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Text="{Binding ProvisioningOperation.Error}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Visibility="Visible" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="ConfirmButton"
                            Content="Confirm and apply"
                            Click="ConfirmButton_Click"
                            IsEnabled="{Binding IsAwaitingConfirmation}" />
                        <Button
                            x:Name="ResumeButton"
                            Content="Resume safely"
                            Click="ResumeButton_Click"
                            IsEnabled="{Binding CanResumeProvisioning}" />
                    </StackPanel>

                    <ProgressRing
                        IsActive="{Binding IsProvisioningActive}"
                        Width="28"
                        Height="28" />

                    <TextBlock
                        Text="If the observed state changes before an uncompleted step, the persisted plan becomes stale and cannot be resumed. Generate a new plan instead."
                        TextWrapping="Wrap"
                        Opacity="0.65" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
