<Window
    x:Class="WorkspaceControl.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="MainWindow">

    <Grid x:Name="RootGrid">
        <NavigationView
            x:Name="NavView"
            x:Uid="MainWindow_Navigation"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainWindow_Overview" Tag="overview" />
                <NavigationViewItem x:Uid="MainWindow_Software" Tag="software" />
                <NavigationViewItem x:Uid="MainWindow_Windows" Tag="windows" />
                <NavigationViewItem x:Uid="MainWindow_Diagnostics" Tag="diagnostics" />
                <NavigationViewItem x:Uid="MainWindow_Profiles" Tag="profiles" />
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="StatusInfoBar"
                    Grid.Row="0"
                    Margin="12,12,12,0"
                    IsOpen="{Binding HasError}"
                    x:Uid="MainWindow_StatusInfoBar"
                    IsClosable="True"
                    Message="{Binding Error}"
                    Severity="Error" />

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    NavigationFailed="ContentFrame_NavigationFailed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
