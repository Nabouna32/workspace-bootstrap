<Window
    x:Class="WorkspaceControl.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Workspace Control">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                Text="Workspace Control"
                FontSize="32"
                FontWeight="SemiBold" />
            <TextBlock
                Text="Windows 11 control center"
                Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,32,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <NavigationView
                Grid.Column="0"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="Left"
                SelectedItem="{x:Bind Navigation.SelectedItem, Mode=TwoWay}">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Overview" Tag="overview" />
                    <NavigationViewItem Content="Software" Tag="software" />
                    <NavigationViewItem Content="Windows" Tag="windows" />
                    <NavigationViewItem Content="Diagnostics" Tag="diagnostics" />
                    <NavigationViewItem Content="Profiles" Tag="profiles" />
                </NavigationView.MenuItems>
            </NavigationView>

            <Border
                Grid.Column="1"
                Margin="24,0,0,0"
                Padding="32"
                CornerRadius="12"
                Background="Transparent">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="Ready"
                        FontSize="24"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="The native WinUI 3 shell is now the presentation target. Product capabilities remain owned by the shared engine."
                        TextWrapping="Wrap"
                        MaxWidth="720"
                        Opacity="0.8" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
