<Window
    x:Class="WorkspaceControl.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Workspace Control">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview" />
                <NavigationViewItem Content="Software" Tag="software" />
                <NavigationViewItem Content="Windows" Tag="windows" />
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics" />
                <NavigationViewItem Content="Profiles" Tag="profiles" />
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="StatusInfoBar"
                    Grid.Row="0"
                    Margin="12,12,12,0"
                    IsOpen="False"
                    IsClosable="True" />

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    NavigationFailed="ContentFrame_NavigationFailed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
