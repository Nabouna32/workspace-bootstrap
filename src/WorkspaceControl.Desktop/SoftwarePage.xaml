<Page
    x:Class="WorkspaceControl.Desktop.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkspaceControl.Desktop">

    <Page.Resources>
        <local:SemanticStatusBrushConverter x:Key="SemanticStatusBrushConverter" />
    </Page.Resources>

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Uid="SoftwarePage_Title" FontSize="32" FontWeight="SemiBold" />
            <TextBlock x:Uid="SoftwarePage_Subtitle" Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,20,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="ApplicationSearchBox"
                x:Uid="SoftwarePage_Search"
                TextChanged="ApplicationSearchBox_TextChanged"
                Grid.Column="0" />

            <ComboBox
                x:Name="ApplicationFilterBox"
                x:Uid="SoftwarePage_Filter"
                SelectionChanged="ApplicationFilterBox_SelectionChanged"
                SelectedIndex="0"
                Grid.Column="1">
                <ComboBoxItem x:Uid="SoftwarePage_FilterAll" Tag="all" />
                <ComboBoxItem x:Uid="SoftwarePage_FilterInstalled" Tag="installed" />
                <ComboBoxItem x:Uid="SoftwarePage_FilterUpdates" Tag="updates" />
                <ComboBoxItem x:Uid="SoftwarePage_FilterAvailable" Tag="available" />
            </ComboBox>

            <Button
                x:Uid="SoftwarePage_Refresh"
                Click="Refresh_Click"
                Grid.Column="2" />

            <ProgressRing
                x:Uid="SoftwarePage_ProgressRing"
                IsActive="{Binding IsBusy}"
                Width="20"
                Height="20"
                Grid.Column="3" />
        </Grid>

        <TextBlock
            x:Uid="SoftwarePage_Results"
            Grid.Row="2"
            Text="{Binding ApplicationCatalogItems.Count}"
            Margin="0,0,0,8"
            Opacity="0.72" />

        <ListView
            Grid.Row="3"
            x:Uid="SoftwarePage_List"
            ItemsSource="{Binding VisibleApplicationCatalogItems}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="12"
                        Margin="0,0,0,8"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Source}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel Spacing="1">
                                        <TextBlock x:Uid="SoftwarePage_InstalledVersion" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{Binding InstalledVersion}" />
                                    </StackPanel>
                                    <StackPanel Spacing="1">
                                        <TextBlock x:Uid="SoftwarePage_AvailableVersion" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{Binding AvailableVersion}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                <TextBlock
                                    x:Uid="SoftwarePage_State"
                                    Text="{Binding StateCode}"
                                    Foreground="{Binding StateCode, Converter={StaticResource SemanticStatusBrushConverter}}"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Uid="SoftwarePage_Action"
                                    Text="{Binding ActionCode}"
                                    Foreground="{Binding ActionCode, Converter={StaticResource SemanticStatusBrushConverter}, ConverterParameter=action}"
                                    Opacity="0.9" />
                            </StackPanel>

                            <Button
                                x:Uid="SoftwarePage_AddToWorkspace"
                                Tag="{Binding ComponentId}"
                                Click="AddToWorkspace_Click"
                                Grid.Column="2"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
