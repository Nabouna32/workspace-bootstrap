<Page
    x:Class="WorkspaceControl.Desktop.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkspaceControl.Desktop">

    <Page.Resources>
        <local:SemanticStatusBrushConverter x:Key="SemanticStatusBrushConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="WorkspacePage_Title" FontSize="32" FontWeight="SemiBold" />
                <TextBlock
                    x:Uid="WorkspacePage_Subtitle"
                    Opacity="0.72"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="20"
                    CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="WorkspacePage_CurrentHeading" FontSize="20" FontWeight="SemiBold" />
                        <ComboBox
                            x:Name="WorkspaceList"
                            x:Uid="WorkspacePage_WorkspaceList"
                            ItemsSource="{Binding Workspaces}"
                            SelectionChanged="WorkspaceList_SelectionChanged"
                            HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Opacity="0.72" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="WorkspaceNameBox"
                                x:Uid="WorkspacePage_Name"
                                Text="{Binding WorkspaceName, Mode=TwoWay}"
                                Grid.Column="0" />
                            <TextBox
                                x:Name="WorkspaceDescriptionBox"
                                x:Uid="WorkspacePage_Description"
                                Text="{Binding WorkspaceDescription, Mode=TwoWay}"
                                Grid.Column="1"
                                TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Uid="WorkspacePage_New" Click="NewWorkspaceButton_Click" />
                            <Button
                                x:Uid="WorkspacePage_Save"
                                Click="SaveWorkspaceButton_Click"
                                IsEnabled="{Binding HasSelectedWorkspace}" />
                            <Button
                                x:Uid="WorkspacePage_Capture"
                                Click="CaptureWorkspaceButton_Click"
                                IsEnabled="{Binding HasSoftwareObservation}" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="WorkspacePage_CaptureHint"
                            TextWrapping="Wrap"
                            Opacity="0.65" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="20"
                    CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="WorkspacePage_IntentHeading" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock
                            x:Uid="WorkspacePage_IntentDescription"
                            TextWrapping="Wrap"
                            Opacity="0.72" />

                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Padding="12" CornerRadius="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="WorkspacePage_ApplicationsDomain.Text" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="WorkspacePage_ApplicationsDomainHint.Text" Opacity="0.65" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Padding="12" CornerRadius="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="WorkspacePage_WindowsDomain.Text" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="WorkspacePage_WindowsDomainHint.Text" Opacity="0.65" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding WindowsAppearanceDisplay}"
                                        Opacity="0.65" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Padding="12" CornerRadius="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="WorkspacePage_OtherDomain.Text" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="WorkspacePage_OtherDomainHint.Text" Opacity="0.65" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Uid="WorkspacePage_Undefined.Text"
                                        Opacity="0.65" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Padding="16"
                CornerRadius="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="WorkspacePage_ObservedHeading"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Uid="WorkspacePage_ObservedDescription"
                        TextWrapping="Wrap"
                        Opacity="0.72" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="10" CornerRadius="10">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="OverviewPage_DetectedEntries.Text" FontSize="12" Opacity="0.6" />
                                <TextBlock Text="{Binding SoftwareCountDisplay}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="10" CornerRadius="10">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="OverviewPage_UpdatesCard.Text" FontSize="12" Opacity="0.6" />
                                <TextBlock Text="{Binding ApplicationUpdatesCount}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="10" CornerRadius="10">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="OverviewPage_DiagnosticsCard.Text" FontSize="12" Opacity="0.6" />
                                <TextBlock Text="{Binding DiagnosticCount}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                CornerRadius="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="WorkspacePage_ScopeHeading" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock
                                x:Uid="WorkspacePage_ScopeDescription"
                                TextWrapping="Wrap"
                                Opacity="0.72" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                            <TextBlock
                                x:Uid="WorkspacePage_UpdatesSummary"
                                FontSize="13"
                                Opacity="0.65" />
                            <TextBlock
                                Text="{Binding ApplicationUpdatesCount}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <TextBlock x:Uid="WorkspacePage_ApplicationsHeading" FontSize="16" FontWeight="SemiBold" />
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="0,8,0,0">
                        <TextBox
                            x:Name="ApplicationSearchBox"
                            x:Uid="WorkspacePage_ApplicationSearch"
                            TextChanged="ApplicationSearchBox_TextChanged" />
    
                        <ListView
                            x:Name="ApplicationList"
                            x:Uid="WorkspacePage_ApplicationList"
                            ItemsSource="{Binding VisibleApplicationOptions}"
                            SelectionMode="None"
                            MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="16" Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
    
                                        <StackPanel Spacing="2">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Width="150"
                                                    SelectedValue="{Binding DesiredState, Mode=TwoWay}"
                                                    SelectedValuePath="Tag">
                                                    <ComboBoxItem x:Uid="WorkspacePage_ApplicationDesiredUndefined" Tag="undefined" />
                                                    <ComboBoxItem x:Uid="WorkspacePage_ApplicationDesiredPresent" Tag="present" />
                                                    <ComboBoxItem x:Uid="WorkspacePage_ApplicationDesiredAbsent" Tag="absent" />
                                                </ComboBox>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,0">
                                                <TextBlock
                                                    Text="{Binding Source}"
                                                    Opacity="0.65"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock
                                                        x:Uid="WorkspacePage_ApplicationInstalled"
                                                        FontSize="12"
                                                        Opacity="0.6" />
                                                    <TextBlock
                                                        Text="{Binding InstalledVersion}"
                                                        FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock
                                                        x:Uid="WorkspacePage_ApplicationAvailable"
                                                        FontSize="12"
                                                        Opacity="0.6" />
                                                    <TextBlock
                                                        Text="{Binding AvailableVersion}"
                                                        FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
    
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding StateCode}"
                                            Foreground="{Binding StateCode, Converter={StaticResource SemanticStatusBrushConverter}}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                CornerRadius="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="WorkspacePage_WindowsAppearanceHeading" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock
                            x:Uid="WorkspacePage_WindowsAppearanceDescription"
                            TextWrapping="Wrap"
                            Opacity="0.72" />
                    </StackPanel>
                    <ComboBox
                        x:Name="WindowsAppearanceComboBox"
                        x:Uid="WorkspacePage_WindowsAppearance"
                        Grid.Column="1"
                        Width="180"
                        SelectedValue="{Binding WindowsAppearance, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem x:Uid="WorkspacePage_WindowsAppearanceSystem" Tag="system" />
                        <ComboBoxItem x:Uid="WorkspacePage_WindowsAppearanceLight" Tag="light" />
                        <ComboBoxItem x:Uid="WorkspacePage_WindowsAppearanceDark" Tag="dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border
                Padding="16"
                CornerRadius="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="WorkspacePage_DiffHeading" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock
                        x:Uid="WorkspacePage_DiffDescription"
                        TextWrapping="Wrap"
                        Opacity="0.72" />
                    <Button
                        x:Name="ObserveDiffButton"
                        x:Uid="WorkspacePage_ObserveDiff"
                        Click="ObserveDiffButton_Click"
                        IsEnabled="False"
                        HorizontalAlignment="Left" />

                    <ListView
                        x:Name="DesiredStateDiffList"
                        x:Uid="WorkspacePage_DiffList"
                        ItemsSource="{Binding DesiredStateDiffItems}"
                        SelectionMode="None"
                        MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.72" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_DiffObserved" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding ObservedValue}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_DiffAvailable" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding AvailableValue}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_DiffDesired" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding DesiredValue}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock
                                                x:Uid="WorkspacePage_DiffAction"
                                                Text="{Binding ActionCode}"
                                                Foreground="{Binding ActionCode, Converter={StaticResource SemanticStatusBrushConverter}, ConverterParameter=action}"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Uid="WorkspacePage_DiffState"
                                                Text="{Binding StateCode}"
                                                Foreground="{Binding StateCode, Converter={StaticResource SemanticStatusBrushConverter}, ConverterParameter=state}"
                                                Opacity="0.85" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        x:Name="CreatePlanButton"
                        x:Uid="WorkspacePage_GeneratePlan"
                        Click="CreatePlanButton_Click"
                        IsEnabled="False"
                        HorizontalAlignment="Left" />                </StackPanel>
            </Border>

            <Border
                Padding="20"
                CornerRadius="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="WorkspacePage_ReviewHeading" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock
                        x:Uid="WorkspacePage_ReviewDescription"
                        TextWrapping="Wrap"
                        Opacity="0.72" />

                    <TextBlock
                        x:Uid="WorkspacePage_Status"
                        Text="{Binding WorkspaceOperationStatusDisplay}"
                        FontSize="17"
                        FontWeight="SemiBold" />

                    <TextBlock
                        x:Uid="WorkspacePage_Progress"
                        Text="{Binding WorkspaceOperationProgressDisplay}"
                        Opacity="0.72" />

                    <TextBlock
                        x:Uid="WorkspacePage_CurrentComponent"
                        Text="{Binding CurrentComponentDisplay}"
                        TextWrapping="Wrap"
                        Opacity="0.72" />

                    <ListView
                        x:Uid="WorkspacePage_PlanList"
                        ItemsSource="{Binding WorkspacePlan.Items}"
                        SelectionMode="None"
                        MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding ComponentName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.72" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_InstalledVersion" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding InstalledVersion}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_AvailableVersion" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding AvailableVersion}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock x:Uid="WorkspacePage_DesiredVersion" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding DesiredVersion}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock
                                                x:Uid="WorkspacePage_ActionCode"
                                                Text="{Binding ActionCode}"
                                                Foreground="{Binding ActionCode, Converter={StaticResource SemanticStatusBrushConverter}, ConverterParameter=action}"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Uid="WorkspacePage_StateCode"
                                                Text="{Binding StateCode}"
                                                Foreground="{Binding StateCode, Converter={StaticResource SemanticStatusBrushConverter}, ConverterParameter=state}"
                                                Opacity="0.85" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <InfoBar
                        x:Uid="WorkspacePage_ErrorInfoBar"
                        IsOpen="{Binding HasWorkspaceOperationError}"
                        Message="{Binding WorkspaceOperationError}"
                        Severity="Error"
                        IsClosable="False" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="ConfirmButton"
                            x:Uid="WorkspacePage_Confirm"
                            Click="ConfirmButton_Click"
                            IsEnabled="{Binding IsAwaitingConfirmation}" />
                        <Button
                            x:Name="ResumeButton"
                            x:Uid="WorkspacePage_Resume"
                            Click="ResumeButton_Click"
                            IsEnabled="{Binding CanResumeWorkspaceOperation}" />
                    </StackPanel>

                    <ProgressRing
                        x:Uid="WorkspacePage_ProgressRing"
                        IsActive="{Binding IsWorkspaceOperationActive}"
                        Width="28"
                        Height="28" />

                    <TextBlock x:Uid="WorkspacePage_StaleNote" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>