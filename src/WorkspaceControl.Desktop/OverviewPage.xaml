<Page
    x:Class="WorkspaceControl.Desktop.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkspaceControl.Desktop">

    <Page.Resources>
        <local:SemanticStatusBrushConverter x:Key="SemanticStatusBrushConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="OverviewPage_Title" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock x:Uid="OverviewPage_Subtitle" Opacity="0.72" TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Uid="OverviewPage_Refresh"
                    Grid.Column="1"
                    Click="Refresh_Click"
                    VerticalAlignment="Center" />
            </Grid>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock x:Uid="OverviewPage_HealthHeading" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding HomeHealthDisplay}"
                            Foreground="{Binding HomeHealthCode, Converter={StaticResource SemanticStatusBrushConverter}}"
                            FontSize="24"
                            FontWeight="SemiBold" />
                        <TextBlock x:Uid="OverviewPage_HealthDescription" TextWrapping="Wrap" Opacity="0.72" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3" MinWidth="170">
                        <TextBlock x:Uid="OverviewPage_WorkspaceHeading" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HomeWorkspaceDisplay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Button x:Uid="OverviewPage_WorkspaceAction" Click="Workspace_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="OverviewPage_ActivityHeading" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HomeWorkspaceOperationDisplay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WorkspaceOperationProgressDisplay}" Opacity="0.72" />
                        <TextBlock Text="{Binding CurrentComponentDisplay}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                        <Button x:Uid="OverviewPage_ActivityAction" Click="Workspace_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="WorkspacePage_DiffHeading" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DesiredStateDiffItems.Count}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkspacePage_IntentDescription" TextWrapping="Wrap" Opacity="0.72" />
                        <Button x:Uid="OverviewPage_WorkspaceQuickAction" Click="Workspace_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="OverviewPage_UpdatesCard" Opacity="0.68" />
                        <TextBlock Text="{Binding ApplicationUpdatesCount}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Uid="OverviewPage_UpdatesHint" Opacity="0.72" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="OverviewPage_ApplicationsCard" Opacity="0.68" />
                        <TextBlock Text="{Binding ApplicationInstalledCount}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Uid="OverviewPage_ApplicationsHint" Opacity="0.72" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="OverviewPage_AvailableCard" Opacity="0.68" />
                        <TextBlock Text="{Binding ApplicationAvailableCount}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Uid="OverviewPage_AvailableHint" Opacity="0.72" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="OverviewPage_DiagnosticsCard" Opacity="0.68" />
                        <TextBlock Text="{Binding DiagnosticCount}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Uid="OverviewPage_DiagnosticsHint" Opacity="0.72" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="OverviewPage_QuickActionsHeading" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Uid="OverviewPage_ApplicationsAction" Click="Applications_Click" />
                        <Button x:Uid="OverviewPage_WorkspaceQuickAction" Click="Workspace_Click" />
                        <Button x:Uid="OverviewPage_DiagnosticsAction" Click="Diagnostics_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
