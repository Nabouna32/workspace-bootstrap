<Page
    x:Class="WorkspaceControl.Desktop.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="OverviewPage_Title" FontSize="32" FontWeight="SemiBold" />
                <TextBlock x:Uid="OverviewPage_Subtitle" Opacity="0.72" />
            </StackPanel>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="OverviewPage_WindowsCard" Opacity="0.68" />
                        <TextBlock Text="{Binding Baseline.Windows}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Baseline.Build}" Opacity="0.72" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="OverviewPage_HardwareCard" Opacity="0.68" />
                        <TextBlock Text="{Binding Baseline.Cpu}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MemoryDisplay}" Opacity="0.72" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="OverviewPage_SoftwareCard" Opacity="0.68" />
                        <TextBlock Text="{Binding Software.Items.Count}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Uid="OverviewPage_DetectedEntries" Opacity="0.72" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="OverviewPage_StatusHeading" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" />
                    <ProgressRing x:Uid="OverviewPage_ProgressRing" IsActive="{Binding IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
                    <Button x:Uid="OverviewPage_Refresh" Click="Refresh_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
