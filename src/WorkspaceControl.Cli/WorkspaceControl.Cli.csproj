<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WorkspaceControl.Cli</AssemblyName>
    <RootNamespace>WorkspaceControl.Cli</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WorkspaceControl.Application\WorkspaceControl.Application.csproj" />
    <ProjectReference Include="..\WorkspaceControl.Infrastructure\WorkspaceControl.Infrastructure.csproj" />
    <Content Include="..\..\catalog\windows\components\**\*.json" LinkBase="catalog\windows\components" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\catalog\windows\templates\*.json" LinkBase="catalog\windows\templates" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
