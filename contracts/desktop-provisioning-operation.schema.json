{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bouna Dev Environment Desktop Provisioning Operation",
  "type": "object",
  "required": [
    "schemaVersion",
    "operationId",
    "status",
    "phase",
    "profileId",
    "completed",
    "total",
    "percent",
    "messageKey",
    "canResume",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["starting", "running", "completed", "failed", "reboot-required"]
    },
    "phase": {
      "type": "string",
      "enum": ["starting", "component", "completed", "error", "reboot"]
    },
    "profileId": { "type": "string", "minLength": 1 },
    "currentComponentId": { "type": ["string", "null"] },
    "currentComponentName": { "type": ["string", "null"] },
    "completed": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "messageKey": { "type": "string", "minLength": 1 },
    "error": { "type": ["string", "null"] },
    "canResume": { "type": "boolean" },
    "nextIndex": { "type": "integer", "minimum": 0 },
    "workerPid": { "type": ["integer", "null"], "minimum": 1 },
    "runId": { "type": ["string", "null"] },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
