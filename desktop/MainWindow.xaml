<Window x:Class="WorkspaceBootstrap.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workspace Bootstrap"
        Width="1320" Height="820"
        MinWidth="1080" MinHeight="700"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Workspace Bootstrap" FontSize="12" Foreground="{StaticResource SecondaryText}"/>
                    <TextBlock Text="Windows 11 • local-first" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WORKSPACE BOOTSTRAP" FontSize="17" FontWeight="SemiBold" Margin="4,4,4,8"
                    /><TextBlock Text="Windows workstation manager" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="4,0,4,24"/>
                    <Button Command="{Binding DashboardCommand}" Content="⌂   Tableau de bord" Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Command="{Binding OptimizationCommand}" Content="⚙   Optimisation" Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Command="{Binding ProvisioningCommand}" Content="▣   Provisionnement" Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Command="{Binding DiagnosticsCommand}" Content="◉   Diagnostic" Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Command="{Binding InventoryCommand}" Content="▦   Logiciels &amp; composants" Style="{StaticResource NavigationButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource SecondaryText}" FontSize="14" Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,18">
                <DockPanel>
                    <ProgressBar IsIndeterminate="True" Width="120" Height="5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid x:Name="DashboardView" Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,18" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Windows" Foreground="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding WindowsValue}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding BuildValue}" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,18" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Processeur" Foreground="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding CpuValue}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CoreValue}" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Mémoire" Foreground="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding MemoryValue}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding UptimeValue}" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}" Padding="22">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="État de la machine" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Lecture seule • aucune modification" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Command="{Binding RefreshCommand}" Content="↻ Actualiser" HorizontalAlignment="Right" Margin="20,0,0,0" Padding="18,9"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Stockage" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StorageValue}" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,20" TextWrapping="Wrap"/>
                                    <TextBlock Text="Démarrage" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StartupValue}" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsOptimizationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                        <Button Command="{Binding OptimizationPlanCommand}" Content="📋 Aperçu Safe" Padding="18,10"/>
                        <Button Command="{Binding OptimizationApplyCommand}" Content="🛡️ Appliquer Safe" Padding="18,10" Margin="10,0,0,0"/>
                        <Button Command="{Binding OptimizationRollbackCommand}" Content="↩ Restaurer" Padding="18,10" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                        <ScrollViewer>
                            <TextBox Text="{Binding OptimizationOutput}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource PrimaryText}"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsProvisioningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Profil" Foreground="{StaticResource SecondaryText}"/>
                                <ComboBox ItemsSource="{Binding ProvisioningProfiles}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedProvisioningProfileId, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,7,16,0"
                                          Padding="8"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProvisioningProfileDescription}"
                                       Foreground="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,22,16,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ProvisioningPlanCommand}" Content="📋 Analyser le plan" Padding="18,10"/>
                                <Button Command="{Binding ProvisioningExecuteCommand}" Content="▶ Installer le plan" Padding="18,10" Margin="10,0,0,0"/>
                                <Button Command="{Binding ProvisioningResumeCommand}" Content="↻ Reprendre" Padding="18,10" Margin="10,0,0,0"/>
                                <Button Command="{Binding ProvisioningHistoryCommand}" Content="🕘 Historique" Padding="18,10" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <Border Visibility="{Binding IsProvisioningOperationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding ProvisioningOperationStatus}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ProvisioningCurrentStep}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProvisioningOperation.Percent}" Height="6" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding ProvisioningOperation.Error}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <Button Command="{Binding ProvisioningResumeCommand}" Content="↻ Reprendre l’opération" HorizontalAlignment="Left" Padding="14,8" Margin="0,10,0,0"
                                                Visibility="{Binding ProvisioningOperation.CanResume, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Command="{Binding ProvisioningLaunchCommand}" Content="▶ Ouvrir le provisioning interactif" Padding="18,10"/>
                                    <TextBlock Text="{Binding ProvisioningOutput}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Plan du profil" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding ProvisioningPlanItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1.4*"/>
                                                            <ColumnDefinition Width="1.4*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Foreground="{StaticResource SecondaryText}" Margin="12,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ActionLabel}" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <DockPanel Margin="0,24,0,8">
                                        <Button DockPanel.Dock="Right" Command="{Binding ProvisioningDetailCommand}" Content="🔎 Voir le détail" Padding="14,7"/>
                                        <TextBlock Text="Historique des opérations" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding ProvisioningHistory}"
                                             SelectedItem="{Binding SelectedProvisioningHistoryItem, Mode=TwoWay}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             MaxHeight="170">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ProfileId}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding OperationId}" Foreground="{StaticResource SecondaryText}" FontSize="11"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ProgressLabel}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding UpdatedAtLabel}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Visibility="{Binding ProvisioningOperationDetail, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="{StaticResource CardBackground}"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,10,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="Détail de l’opération" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ProvisioningDetailSummary}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ProvisioningDetailLogs}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsInventoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Logiciels &amp; composants" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding InventorySummary}" Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding InventoryOlderSummary}" Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding InventoryProviderHealthSummary}" Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding InventoryScanCommand}" Content="↻ Analyser" Padding="18,10" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Inventaire observé" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding InventorySnapshot.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.4*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Id}" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding FamilyId}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Ownership}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Candidats de nettoyage" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8"/>
                                <ItemsControl ItemsSource="{Binding InventoryRecommendationItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding InstalledVersionLabel}" Foreground="{StaticResource SecondaryText}"/>
                                                    <TextBlock Text="{Binding ReasonLabel}" Foreground="{StaticResource SecondaryText}"/>
                                                    <TextBlock Text="{Binding NewerVersionLabel}" Foreground="{StaticResource SecondaryText}"/>
                                                    <TextBlock Text="{Binding PublisherLabel}" Foreground="{StaticResource SecondaryText}"/>
                                                    <TextBlock Text="{Binding EvidenceLabel}" Foreground="{StaticResource SecondaryText}"/>
                                                    <TextBlock Text="Suppression uniquement après validation explicite." Foreground="{StaticResource Accent}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsDiagnosticsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Diagnostic" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Les diagnostics détaillés seront progressivement exposés ici sans dupliquer la logique du moteur natif."
                                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,20"/>
                            <Button Command="{Binding RefreshCommand}" Content="↻ Recharger le baseline" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
