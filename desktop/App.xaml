<Application x:Class="WorkspaceBootstrap.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0B0D10"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#11151A"/>
        <SolidColorBrush x:Key="SidebarSelected" Color="#1D2633"/>
        <SolidColorBrush x:Key="CardBackground" Color="#14191F"/>
        <SolidColorBrush x:Key="CardBackgroundElevated" Color="#181E26"/>
        <SolidColorBrush x:Key="CardBorder" Color="#28313C"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#9AA6B2"/>
        <SolidColorBrush x:Key="Accent" Color="#78A9FF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#20334F"/>
        <SolidColorBrush x:Key="Success" Color="#63D6A0"/>
        <SolidColorBrush x:Key="Warning" Color="#F3C969"/>
        <SolidColorBrush x:Key="Danger" Color="#FF7D86"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBackgroundElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
        </Style>
    </Application.Resources>
</Application>