{
  "id": "edge",
  "name": "Microsoft Edge",
  "category": "browser",
  "profiles": ["base"],
  "platforms": [
    "windows"
  ],
  "versionPolicy": "latest-stable",
  "packageManager": "winget",
  "packageId": "Microsoft.Edge",
  "source": "winget",
  "installerType": "exe",
  "installer": "Install-WingetPackage.ps1",
  "installerParameters": [
    "-PackageId",
    "Microsoft.Edge"
  ],
  "dependencies": [],
  "prerequisites": [
    {
      "type": "admin"
    },
    {
      "type": "windows-build",
      "minimum": 22000
    },
    {
      "type": "command",
      "name": "winget"
    }
  ],
  "checks": [
    {
      "type": "file-any",
      "paths": [
        "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
        "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"
      ]
    }
  ]
}
