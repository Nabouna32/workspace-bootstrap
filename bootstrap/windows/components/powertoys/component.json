{
  "id": "powertoys",
  "name": "Microsoft PowerToys",
  "category": "utility",
  "profiles": [
    "development"
  ],
  "platforms": [
    "windows"
  ],
  "versionPolicy": "latest-stable",
  "packageId": "Microsoft.PowerToys",
  "installerType": "exe",
  "dependencies": [],
  "prerequisites": [
    {
      "type": "admin"
    },
    {
      "type": "windows-build",
      "minimum": 22000
    },
    {
      "type": "command",
      "name": "winget"
    }
  ],
  "checks": [
    {
      "type": "file-any",
      "paths": [
        "C:\\Program Files\\PowerToys\\PowerToys.exe"
      ]
    }
  ],
  "fallbackPackageManager": "winget"
}
