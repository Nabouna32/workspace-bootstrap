{
  "id": "powershell",
  "name": "PowerShell 7",
  "category": "desktop",
  "profiles": ["base"],
  "platforms": ["windows"],
  "versionPolicy": "minimum",
  "minimumVersion": "7.6.6",
  "fallbackPackageManager": "winget",
  "packageId": "Microsoft.PowerShell",
  "source": "official",
  "installerType": "wix",
  "locale": "fr-FR",
  "architecture": "x64",
  "officialSource": {
    "type": "github-release",
    "repository": "PowerShell/PowerShell",
    "assetRegex": "^PowerShell-[0-9.]+-win-x64\\.msi$",
    "versionRegex": "^v(.+)$"
  },
  "installArguments": ["/quiet","ADD_EXPLORER_CONTEXT_MENU_OPENPOWERSHELL=1","ADD_FILE_CONTEXT_MENU_RUNPOWERSHELL=1","ENABLE_PSREMOTING=1","REGISTER_MANIFEST=1","USE_MU=1","ENABLE_MU=1","ADD_PATH=1"],
  "dependencies": [],
  "prerequisites": [{"type":"admin"},{"type":"windows-build","minimum":22000}],
  "checks": [{"type":"command-version","name":"pwsh","arguments":["-NoProfile","-Command","$PSVersionTable.PSVersion.ToString()"],"minimum":"7.6.6"}],
  "installer": "Install-WingetPackage.ps1",
  "installerParameters": ["-PackageId","Microsoft.PowerShell"]
}