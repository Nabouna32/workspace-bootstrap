{
  "id": "prismlauncher",
  "name": "Prism Launcher",
  "category": "gaming",
  "profiles": [
    "gaming"
  ],
  "platforms": [
    "windows"
  ],
  "versionPolicy": "latest-stable",
  "packageId": "PrismLauncher.PrismLauncher",
  "installerType": "exe",
  "dependencies": [],
  "prerequisites": [
    {
      "type": "admin"
    },
    {
      "type": "windows-build",
      "minimum": 22000
    },
    {
      "type": "command",
      "name": "winget"
    }
  ],
  "checks": [
    {
      "type": "file-any",
      "paths": [
        "C:\\Program Files\\PrismLauncher\\prismlauncher.exe",
        "C:\\Program Files (x86)\\PrismLauncher\\prismlauncher.exe"
      ]
    }
  ],
  "fallbackPackageManager": "winget"
}
